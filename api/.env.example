# Node + MySQL API for Meowtrek

# MySQL (docker-compose below spins one up at this URL)
DATABASE_URL="mysql://meowtrek:meowtrek@127.0.0.1:3307/meowtrek"

PORT=8080

# AI coach (optional; coach endpoints return 503 without it)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# App Store (Plus verification + server notifications)
APPLE_BUNDLE_ID=id.gian.meowtrek
APPLE_ENVIRONMENT=Sandbox      # or Production
APPLE_APP_ID=                  # required when Production
ALLOW_UNVERIFIED_PLUS=false    # dev only: trust the JWS without Apple verification

# APNs push (optional)
APNS_KEY=                      # the .p8 private key contents (PEM)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_ENVIRONMENT=              # defaults to APPLE_ENVIRONMENT
APNS_TOPIC=                    # defaults to APPLE_BUNDLE_ID

# Garmin Health API (optional)
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GARMIN_WEBHOOK_SECRET=

# Admin (telemetry summary)
ADMIN_TOKEN=
