{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "shouldTranslate": false
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap your meal so your cat can react to it."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto makananmu supaya kucingmu bisa kasih reaksi."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek reads your steps so your cat can walk with you."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek membaca langkahmu supaya kucingmu bisa ikut jalan."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek saves your treks and water to Apple Health."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek menyimpan trek dan minummu ke Apple Health."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek keeps recording your route when the screen is off during a trek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek tetap merekam rutemu saat layar mati selama trek."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek draws your route while you walk, run or hike."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek menggambar rutemu saat kamu jalan, lari, atau hiking."
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek counts your steps live so your cat can cheer you on."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meowtrek menghitung langkahmu langsung supaya kucingmu bisa menyemangati."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your Meowtrek cards to Photos."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan kartu Meowtrek-mu ke Foto."
          }
        }
      }
    }
  },
  "version": "1.0"
}